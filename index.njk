---
layout: layouts/base.njk
---
<section class="intro">
  <h1 class="intro-title">toilet time<br><em>explorations</em><span class="intro-dot">.</span></h1>
  <p class="intro-tagline">{{ site.description }}</p>
</section>

<section class="post-list">
  {%- for post in collections.posts | reverse %}
  <a class="post-item" href="{{ post.url }}">
    <span class="post-num">{{ (loop.length - loop.index0) | pad2 }}</span>
    <span class="post-item-main">
      <h2 class="post-item-title">{{ post.data.title }}</h2>
      {%- if post.data.summary %}
      <p class="post-item-summary">{{ post.data.summary }}</p>
      {%- endif %}
      <time class="post-item-date" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
      {%- if post.data.series %}<span class="series-chip">{{ post.data.series }} · part {{ post.data.seriesPart }}</span>{% endif %}
      {%- if post.data.topics %}
      <span class="item-topics">
        {%- for topic in post.data.topics %}<span class="tag-chip">#{{ topic }}</span>{% endfor %}
      </span>
      {%- endif %}
    </span>
    <span class="post-arrow" aria-hidden="true">&rarr;</span>
  </a>
  {%- endfor %}
</section>
